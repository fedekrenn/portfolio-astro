---
import Layout from "@layouts/Layout.astro";
import Detail from "@components/Detail.astro";
import { getExperience } from "@services/getData";
import type { Project } from "src/types/types";

export function getStaticPaths() {
  return getExperience().map((experience) => ({
    params: { id: experience.id.toString() },
    props: { experience },
  }));
}

const { experience } = Astro.props as { experience: Project };
---

<Layout
  title={`${experience.title} | Federico Krenn`}
  description={experience.meta}
>
  <main>
    <Detail {experience} />
  </main>
</Layout>

<style>
  main {
    margin-top: 80px;
  }
</style>
